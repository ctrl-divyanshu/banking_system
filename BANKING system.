class Acc:
    def __init__(self,holder,bal):
        self.holder=holder
        self.balance=bal
        
        
    @staticmethod
    def int_cal(princ,rate,time):
        interest=(princ*rate*time)/100
        print("your interest is:--", interest)
       
        
         
            
     
    def credit(self,amount):
        self.balance+=amount
        print("Hello...", self.holder,"Updated balance is:--",self.balance)


    def debit(self,amount):
        if (amount>=self.balance):
            print("Not enough funds")
            print("available bal is",self.balance)
        else:
            
            self.balance-=amount
            print("Hello MR.", self.holder,"Updated balance is:--",self.balance)
        
    def get_bal(self):
        print("Hello", self.holder,"remaining bal:--", self.balance)
        #print(self.balance)
        return self.balance
        #print(self.balance)
        print(self.balance)
        
    
        
        
        
